---
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const chapters = (await getCollection("tdd")).sort(
  (a, b) => a.data.order - b.data.order,
);
const canonicalURL = new URL("/tdd/", Astro.site).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Learn Java with Tests",
  description:
    "A test-driven development course for Java, inspired by Learn Go with Tests.",
  url: canonicalURL,
  provider: {
    "@type": "Person",
    name: SITE_TITLE,
    url: new URL("/", Astro.site).toString(),
  },
  hasPart: chapters.map((chapter) => ({
    "@type": "LearningResource",
    name: chapter.data.title,
    description: chapter.data.description,
    url: new URL(`/tdd/${chapter.id}/`, Astro.site).toString(),
  })),
};
const steps = [
  {
    title: "Write a failing test",
    body: "Describe one piece of behaviour as a test before any production code exists.",
  },
  {
    title: "Make it pass",
    body: "Write the minimum code to satisfy the test — no more than that.",
  },
  {
    title: "Refactor",
    body: "Clean up the code while the green tests keep you safe. Repeat.",
  },
];
---

<BaseLayout
  title="Learn Java with Tests"
  description="A test-driven development course for Java, inspired by Learn Go with Tests."
  structuredData={structuredData}
>
  <div class="container course-index">
    <header class="course-index__header">
      <a class="course-index__back" href="/">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Home
      </a>
      <p class="section-kicker">Course</p>
      <h1>Learn Java with Tests</h1>
      <p class="course-index__lede">
        A test-driven development course for Java, inspired by{" "}
        <a href="https://quii.gitbook.io/learn-go-with-tests"
          >Learn Go with Tests</a
        >. Every chapter is a tiny, self-contained package: read the failing
        test, implement the minimum to make it pass, refactor.
      </p>
    </header>

    <section class="course-howto" aria-labelledby="start-heading">
      <h2 id="start-heading">Start here — clone the blank template</h2>
      <p>
        This course is a <strong>do</strong>, not a read. Clone the{" "}
        <strong>blank starter project</strong> — Gradle, JUnit 5 and AssertJ are already
        wired — and you build each chapter's package yourself:
      </p>
      <pre
        class="course-howto__code"><code>{`git clone https://github.com/gdguesser/learn-java-with-tests-starter.git
cd learn-java-with-tests-starter
./gradlew test                     # toolchain ready, no tests yet`}</code></pre>
      <p>
        <code>./gradlew test</code> is the loop that drives every chapter; on Windows
        use <code>gradlew.bat test</code>. Then open{" "}
        <a href="/tdd/hello/">chapter 01</a> and create{" "}
        <code>src/main/java/hello</code> and <code>src/test/java/hello</code>{
          " "
        }
        yourself — your first failing run (a "cannot find symbol" compile error) will
        be your first <strong>RED</strong>.
      </p>
      <p>
        The{" "}
        <a href="https://github.com/gdguesser/learn-java-with-tests"
          >solutions repo</a
        >{" "}
        contains all 18 chapters written and tested — compare against it once a chapter
        is green. Full setup walkthrough (JDK install, editors, troubleshooting):{
          " "
        }
        <a
          href="https://github.com/gdguesser/learn-java-with-tests#getting-started"
          >Getting started</a
        >.
      </p>
    </section>

    <section class="course-steps" aria-label="The TDD loop">
      {
        steps.map((step, i) => (
          <div class="course-steps__card">
            <span class="course-steps__num">{i + 1}</span>
            <h2>{step.title}</h2>
            <p>{step.body}</p>
          </div>
        ))
      }
    </section>

    <section class="course-chapters" aria-labelledby="chapters-heading">
      <h2 id="chapters-heading">Chapters</h2>
      <ol class="course-list">
        {
          chapters.map((chapter) => (
            <li>
              <a href={`/tdd/${chapter.id}/`}>
                <span class="course-list__num">
                  {String(chapter.data.order).padStart(2, "0")}
                </span>
                <span class="course-list__body">
                  <span class="course-list__title">{chapter.data.title}</span>
                  <span class="course-list__desc">
                    {chapter.data.description}
                  </span>
                </span>
                <svg
                  class="course-list__arrow"
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>
